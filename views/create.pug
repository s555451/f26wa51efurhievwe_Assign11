extends layout

block content
  h1= title
  form(method='POST', action='/mydata/create')
    p
      label(for='name') Name
      br
      input#name(type='text', name='name', required)
    p
      label(for='category') Category
      br
      input#category(type='text', name='category', required)
    p
      label(for='description') Description
      br
      textarea#description(name='description', rows='4', cols='40', required)
    button(type='submit') Create
  p
    a(href='/mydata') Back to Show All
